<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="VerticalStackLayout">
        <Setter Property="VerticalOptions"
                Value="CenterAndExpand"></Setter>
        <Setter Property="Margin"
                Value="0,0,25,0"></Setter>
    </Style>
    
    <Style Class="LabelText" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource LightText},Dark={StaticResource DarkText}}"></Setter>
        <Setter Property="HorizontalTextAlignment"
                Value="End"></Setter>
    </Style>
        
    <Style Class="LabelOperations" TargetType="Label">
            <Setter Property="FontSize" Value="25"></Setter>
    </Style>
        <Style Class="LabelResult" TargetType="Label">
            <Setter Property="FontSize" Value="50"></Setter>
    </Style>
        
        <Style TargetType="BoxView">
                <Setter Property="Color"
                        Value="{AppThemeBinding Light={StaticResource LightText},Dark={StaticResource DarkText}}">
                </Setter>
                <Setter Property="CornerRadius"
                        Value="30,30,0,0"></Setter>
        </Style>
</ResourceDictionary>