<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BasicCalc.CalcView">
    <Grid RowDefinitions=".4*,.6*">
        <VerticalStackLayout>
            <Label Text="{Binding Formula}"
                   StyleClass="LabelText,LabelOperations" ></Label>
            <Label Text="{Binding Result}"
                   StyleClass="LabelText,LabelResult"></Label>
        </VerticalStackLayout>
        <Grid Grid.Row="1">
            <BoxView></BoxView>
            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="15"
                  RowDefinitions="*,*,*,*,*"
                  RowSpacing="15"
                  Padding="15">
                <Button Text="AC"
                        Command="{Binding ResetCommand}"></Button>
                <Button Text="BackSpace"
                        Grid.Column="1"
                        Command="{Binding BackspaceCommand}"></Button>
                <Button Text="%"
                        Grid.Column="2"
                        Command="{Binding operationcommand}"
                        CommandParameter=" % "></Button>
                <Button Text="/"
                        Grid.Column="3"
                        Command="{Binding operationcommand}"
                        CommandParameter=" / "></Button>
                    
                <Button Text="7"
                        Grid.Row="1"
                        Grid.Column="0"
                        Command="{Binding operationcommand}"
                        CommandParameter="7"></Button>
                <Button Text="8"
                        Grid.Row="1"
                        Grid.Column="1"
                        Command="{Binding operationcommand}"
                        CommandParameter="8"></Button>
                <Button Text="9"
                        Grid.Row="1"
                        Grid.Column="2"
                        Command="{Binding operationcommand}"
                        CommandParameter="9"></Button>
                    <Button Text="*"
                            Grid.Row="1"
                            Grid.Column="3"
                            Command="{Binding operationcommand}"
                            CommandParameter=" * "></Button>
                    <Button Text="4"
                            Grid.Row="2"
                            Grid.Column="0"
                            Command="{Binding operationcommand}"
                            CommandParameter="4"></Button>
                <Button Text="5"
                        Grid.Row="2"
                        Grid.Column="1"
                        Command="{Binding operationcommand}"
                        CommandParameter="5"></Button>
                <Button Text="6"
                        Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding operationcommand}"
                        CommandParameter="6"></Button>
                    <Button Text="-"
                            Grid.Row="2"
                            Grid.Column="3"
                            Command="{Binding operationcommand}"
                            CommandParameter=" - "></Button>
                    <Button Text="1"
                            Grid.Row="3"
                            Grid.Column="0"
                            Command="{Binding operationcommand}"
                            CommandParameter="1"></Button>
                <Button Text="2"
                        Grid.Row="3"
                        Grid.Column="1"
                        Command="{Binding operationcommand}"
                        CommandParameter="2"></Button>
                <Button Text="3"
                        Grid.Row="3"
                        Grid.Column="2"
                        Command="{Binding operationcommand}"
                        CommandParameter="3"></Button>
                    <Button Text="+"
                            Grid.Row="3"
                            Grid.Column="3"
                            Command="{Binding operationcommand}"
                            CommandParameter=" + "></Button>
                    
                    <Button Text="0"
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Command="{Binding operationcommand}"
                            CommandParameter="0"></Button>
                <Button Text="."
                        Grid.Row="4"
                        Grid.Column="2"
                        Command="{Binding operationcommand}"
                        CommandParameter="."></Button>
                <Button Text="="
                        Grid.Row="4"
                        Grid.Column="3"
                        Command="{Binding CalculateCommand}"></Button>
            </Grid>
            
        </Grid>
    </Grid>
</ContentPage>